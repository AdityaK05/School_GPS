# ==============================================================================
# School Transport Safety & Accountability Platform - Environment Template
# NEVER COMMIT REAL PRODUCTION SECRETS OR SENSITIVE KEYS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API SERVER CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO
CORS_ORIGIN=*

# Supabase Public Endpoint (Safe for Server & Client)
SUPABASE_URL=https://wsddukyzfpazndprbnsr.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Supabase Server-Only Secret Key (NEVER expose to browser/mobile)
# Retrieve from Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Push Notification Service (Firebase Cloud Messaging - FCM)
# Server-only. If credentials are empty or FCM_DRY_RUN=true, notifications log safely in dry-run mode
FIREBASE_PROJECT_ID=school-gps-production
FIREBASE_SERVER_KEY=
FCM_DRY_RUN=true
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Groq AI Parent Transport Assistant (Server-Only Secret)
# Never expose GROQ_API_KEY to browser, mobile, Vite, or client bundles
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_ENABLED=true

# ------------------------------------------------------------------------------
# 2. ADMIN WEB CONFIGURATION (apps/admin-web/.env.local - Public Client Safe)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://wsddukyzfpazndprbnsr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. MOBILE APP CONFIGURATION (apps/mobile/.env - Public Client Safe)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://wsddukyzfpazndprbnsr.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
