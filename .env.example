# ==============================================================================
# School Transport Safety & Accountability Platform - Environment Template
# NEVER COMMIT REAL PRODUCTION SECRETS OR SENSITIVE KEYS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API SERVER CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO
CORS_ORIGIN=http://localhost,http://127.0.0.1

# Start local Supabase with `supabase start`; use its API URL and keys here.
SUPABASE_URL=http://host.docker.internal:54321

# Server-only. Never expose this key to browser/mobile builds.
SUPABASE_SERVICE_ROLE_KEY=
GPS_INGEST_TOKEN=
TRACCAR_DB_PASSWORD=
WEB_PORT=8080

# Public Supabase Auth settings embedded in the admin web build.
# The anon/publishable key is not a service-role secret; authorization remains server-enforced.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# Push Notification Service (Firebase Cloud Messaging - FCM)
# Server-only. If credentials are empty or FCM_DRY_RUN=true, notifications log safely in dry-run mode
FIREBASE_PROJECT_ID=
FIREBASE_SERVER_KEY=
FCM_DRY_RUN=true
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Groq AI Parent Transport Assistant (Server-Only Secret)
# Never expose GROQ_API_KEY to browser, mobile, Vite, or client bundles
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_ENABLED=false

# ------------------------------------------------------------------------------
# 2. ADMIN WEB CONFIGURATION (apps/admin-web/.env.local - Public Client Safe)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 3. MOBILE APP CONFIGURATION (apps/mobile/.env - Public Client Safe)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
